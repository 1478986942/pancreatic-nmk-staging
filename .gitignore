*.pyc
.ipynb_checkpoints/
.cache/
.browser4-cli/
.agnes/
.vscode/
.trae/

# 编译产物
latex/build/
*.aux
*.log
*.out

# ============================================================
# 精简可复现审计包：明确排除本地工具、原始数据与无关项目
# ============================================================

